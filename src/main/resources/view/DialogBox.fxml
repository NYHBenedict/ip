<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT" type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" wrapText="true" maxWidth="280.0" />
        <ImageView fx:id="displayPicture" fitHeight="100.0" fitWidth="100.0"
                   pickOnBounds="true" preserveRatio="true"
                   visible="false" managed="false" />
    </children>
</fx:root>
